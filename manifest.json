{
  "manifest_version": 3,
  "name": "SpookCam — Halloween Webcam FX",
  "short_name": "SpookCam",
  "version": "1.0.0",
  "description": "Horror face filters, Thanos-snap disintegration, invisibility and haunted backdrops for your webcam — in Meet, Zoom, Teams and any site.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SpookCam",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "studio.html",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*", "wasm/*", "detector.html", "detector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "snap": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Snap — vanish / reappear"
    },
    "relearn-background": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Re-learn the background behind you"
    },
    "scare": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Jump scare — trigger a hallucination now"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
